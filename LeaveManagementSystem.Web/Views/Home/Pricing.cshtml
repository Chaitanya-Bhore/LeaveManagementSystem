@{
    ViewData["Title"] = "Pricing";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4">Pricing</h1>
        <p class="lead">Flexible plans for teams of every size. Choose the tier that fits your organization's leave management needs.</p>
    </div>

    <div class="row g-4 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Starter</h5>
                    <p class="card-subtitle mb-3 text-muted">For individual use or very small teams</p>

                    <div class="mb-4">
                        <h2 class="h1 mb-0">Free</h2>
                        <p class="text-muted">Up to 5 users</p>
                    </div>

                    <ul class="list-unstyled flex-grow-1">
                        <li class="mb-2">Basic leave request & approval</li>
                        <li class="mb-2">Employee profile & leave balance</li>
                        <li class="mb-2">Email notifications</li>
                        <li class="mb-2">Standard support</li>
                    </ul>

                    <div class="mt-3">
                        <a class="btn btn-outline-primary w-100" href="#">Get Started</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-primary shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Team</h5>
                    <p class="card-subtitle mb-3 text-muted">Popular — for growing teams and HR</p>

                    <div class="mb-4">
                        <h2 class="h1 mb-0">$6<span class="fs-5">/user/mo</span></h2>
                        <p class="text-muted">Billed monthly. Volume discounts available.</p>
                    </div>

                    <ul class="list-unstyled flex-grow-1">
                        <li class="mb-2">Everything in Starter</li>
                        <li class="mb-2">Team calendars & shared approvals</li>
                        <li class="mb-2">CSV exports & simple reporting</li>
                        <li class="mb-2">Custom leave types</li>
                        <li class="mb-2">Priority email support</li>
                    </ul>

                    <div class="mt-3">
                        <a class="btn btn-primary w-100" href="#">Start Free Trial</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Enterprise</h5>
                    <p class="card-subtitle mb-3 text-muted">For large organizations with advanced requirements</p>

                    <div class="mb-4">
                        <h2 class="h1 mb-0">Custom</h2>
                        <p class="text-muted">Contact sales for pricing</p>
                    </div>

                    <ul class="list-unstyled flex-grow-1">
                        <li class="mb-2">Everything in Team</li>
                        <li class="mb-2">Single Sign-On (SAML/SSO)</li>
                        <li class="mb-2">Advanced reporting & analytics</li>
                        <li class="mb-2">Service-level agreements & priority support</li>
                        <li class="mb-2">Onboarding assistance and integrations</li>
                    </ul>

                    <div class="mt-3">
                        <a class="btn btn-outline-secondary w-100" href="#">Contact Sales</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 bg-light p-3">
                <div class="card-body">
                    <h5 class="card-title">Compare features</h5>
                    <p class="card-text text-muted">All plans include secure data storage and administrative controls. Choose a plan based on team size, reporting needs, and required integrations.</p>

                    <div class="table-responsive">
                        <table class="table table-borderless">
                            <thead>
                                <tr>
                                    <th style="width:40%"></th>
                                    <th class="text-center">Starter</th>
                                    <th class="text-center">Team</th>
                                    <th class="text-center">Enterprise</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Leave approvals</td>
                                    <td class="text-center">Basic</td>
                                    <td class="text-center">Workflow rules</td>
                                    <td class="text-center">Custom workflows</td>
                                </tr>
                                <tr>
                                    <td>Reporting</td>
                                    <td class="text-center">Limited</td>
                                    <td class="text-center">Export & dashboards</td>
                                    <td class="text-center">Advanced analytics</td>
                                </tr>
                                <tr>
                                    <td>Integrations</td>
                                    <td class="text-center">None</td>
                                    <td class="text-center">HR & Calendar</td>
                                    <td class="text-center">Custom APIs</td>
                                </tr>
                                <tr>
                                    <td>Support</td>
                                    <td class="text-center">Email</td>
                                    <td class="text-center">Priority email</td>
                                    <td class="text-center">Dedicated support</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <p class="mb-0 text-muted">Need a tailored plan? <a href="#">Contact our sales team</a> to discuss custom options.</p>
                </div>
            </div>
        </div>
    </div>
</div>
